.PHONY: help test demo build fmt validate workflows gitlab-e2e tf-validate tf-test manifests tenants rules gitops-values

help: ## Show targets
	@grep -E '^[a-z-]+:.*##' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-12s %s\n", $$1, $$2}'

# Statement coverage `make test` requires. Raise it when tests land, never lower it quietly.
COVERAGE_FLOOR ?= 70

test: ## gofmt, go vet, race-checked unit tests, coverage floor
	! gofmt -l autoscaler | grep .
	cd autoscaler && go vet ./... && go test -race -covermode=atomic -coverprofile=coverage.out ./...
	cd autoscaler && go tool cover -func=coverage.out | awk -v floor=$(COVERAGE_FLOOR) \
		'/^total:/ { sub("%", "", $$NF); printf "coverage %s%% (floor %s%%)\n", $$NF, floor; exit !($$NF >= floor) }'

demo: ## Run the autoscaler against a replayed queue, no cluster needed
	cd autoscaler && go run ./cmd/warmpool-autoscaler \
		--source=static --dry-run --schedule=never \
		--interval=1s --scale-down-stabilization=3s --listen=127.0.0.1:8080

build: ## Build the container image locally
	docker build -t warmpool-autoscaler:dev autoscaler

fmt: ## Format Go and Terraform
	cd autoscaler && gofmt -w .
	terraform fmt -recursive terraform

validate: workflows tf-validate tf-test manifests tenants rules ## Everything CI checks except Go

# actionlint, with shellcheck on every run step, at the version CI pins.
workflows:
	docker run --rm -v "$(CURDIR):/repo:ro" -w /repo rhysd/actionlint:$$(cat .github/versions/actionlint) -color

tf-validate:
	terraform fmt -check -recursive terraform
	for d in terraform/modules/runner-fleet terraform/examples/eks; do \
		terraform -chdir=$$d init -backend=false -input=false >/dev/null && terraform -chdir=$$d validate; \
	done

# Proves the module's guardrails (terraform/modules/runner-fleet/tests) and
# that gitops/tenants/*/ is what the example renders
# (terraform/examples/eks/tests), with every provider mocked. No AWS, no cluster.
tf-test:
	for d in terraform/modules/runner-fleet terraform/examples/eks; do \
		terraform -chdir=$$d init -backend=false -input=false >/dev/null && terraform -chdir=$$d test || exit 1; \
	done

# A real GitLab CE runs each tenant's jobs on a throwaway kind cluster, with
# the autoscaler reading its queue. Needs Docker with ~6 GB free and kind;
# takes about 10 minutes, most of it GitLab booting. failCgroupV1: false lets
# the cluster start on Docker hosts still on cgroup v1 (older WSL2 kernels).
gitlab-e2e: ## End to end against a real GitLab on kind (slow)
	printf 'kind: Cluster\napiVersion: kind.x-k8s.io/v1alpha4\nkubeadmConfigPatches:\n  - |\n    kind: KubeletConfiguration\n    failCgroupV1: false\n' | \
		kind create cluster --name gitlab-e2e --config -
	.github/scripts/gitlab-e2e.sh; rc=$$?; docker rm -f gitlab-e2e >/dev/null; kind delete cluster --name gitlab-e2e; exit $$rc

# Argo CD CRD schemas for kubeconform, from the datree CRDs catalog pinned to
# a commit so the check is reproducible. Bump deliberately.
CRDS_CATALOG_REV ?= 3e8a8916ca1b7af6464606c2c2f5869dbafa9653
CRDS_CATALOG = https://raw.githubusercontent.com/datreeio/CRDs-catalog/$(CRDS_CATALOG_REV)/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json

manifests:
	kubectl kustomize deploy/autoscaler | kubeconform -strict -summary -
	kubeconform -strict -summary -schema-location default -schema-location '$(CRDS_CATALOG)' gitops/bootstrap gitops/platform .github/e2e

# Each tenant's values must render with the chart version its config.json
# pins, into objects that pass the Kubernetes schemas.
tenants:
	for d in gitops/tenants/*/; do \
		t=$$(basename $$d); v=$$(jq -r .chartVersion $$d/config.json); echo "== $$t (gitlab-runner $$v)"; \
		helm template gitlab-runner gitlab-runner --repo https://charts.gitlab.io --version "$$v" \
			--namespace "ci-$$t" -f $$d/values.yaml | kubeconform -strict -summary - || exit 1; \
	done

rules:
	promtool check rules observability/prometheus-rules.yaml
	promtool test rules observability/prometheus-rules.test.yaml

CHART_VERSION ?= $(shell terraform -chdir=terraform/examples/eks output -raw chart_version 2>/dev/null || echo 0.71.0)

gitops-values: ## Write Terraform-rendered runner values to gitops/tenants/ (GitOps mode)
	@terraform -chdir=terraform/examples/eks output -json runner_helm_values > .runner-values.json
	@for t in $$(jq -r 'keys[]' .runner-values.json); do \
		mkdir -p gitops/tenants/$$t; \
		{ printf '# GENERATED by `make gitops-values` from the runner-fleet Terraform module.\n# Do not edit by hand: change Terraform inputs and regenerate.\n'; \
		  jq -r --arg t $$t '.[$$t]' .runner-values.json; } > gitops/tenants/$$t/values.yaml; \
		jq -n --arg t $$t --arg v "$(CHART_VERSION)" '{tenant: $$t, chartVersion: $$v}' > gitops/tenants/$$t/config.json; \
		echo "wrote gitops/tenants/$$t"; \
	done
	@rm -f .runner-values.json
